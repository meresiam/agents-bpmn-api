generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  tenantId  String
  role      Role      @default(CLIENT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]

  @@index([tenantId], name: "idx_users_tenant_id")
  @@map("users")
}

model Process {
  id              String          @id @default(uuid())
  tenantId        String
  slug            String
  title           String
  description     String?
  category        ProcessCategory @default(COMERCIAL)
  graph           Json
  layoutOverrides Json?
  version         Int             @default(1)
  // Pareamento AS-IS / TO-BE (Wave 4, Epic 4.A). Default SINGLE preserva processos existentes.
  processKind     ProcessKind     @default(SINGLE)
  pairedProcessId String?         @unique
  pairedProcess   Process?        @relation("ProcessPair", fields: [pairedProcessId], references: [id], onDelete: SetNull)
  pairedFrom      Process?        @relation("ProcessPair")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  threads         CommentThread[]
  stickyNotes     StickyNote[]

  @@unique([tenantId, slug], name: "uq_process_tenant_slug")
  @@index([tenantId], name: "idx_processes_tenant_id")
  @@map("processes")
}

enum ProcessKind {
  SINGLE
  AS_IS
  TO_BE
}

enum ProcessCategory {
  COMERCIAL
  MARKETING
  FINANCEIRO
  OPERACOES
  RH
  ATENDIMENTO
  ONBOARDING
  LOGISTICA
  JURIDICO
  TI
  OUTRO
}

model CommentThread {
  id        String    @id @default(uuid())
  processId String
  process   Process   @relation(fields: [processId], references: [id], onDelete: Cascade)
  x         Float
  y         Float
  resolved  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]

  @@index([processId], name: "idx_comment_threads_process_id")
  @@map("comment_threads")
}

model Comment {
  id        String        @id @default(uuid())
  content   String
  threadId  String
  thread    CommentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([threadId], name: "idx_comments_thread_id")
  @@map("comments")
}

model StickyNote {
  id        String    @id @default(uuid())
  processId String
  process   Process   @relation(fields: [processId], references: [id], onDelete: Cascade)
  content   String
  color     NoteColor @default(YELLOW)
  x         Float
  y         Float
  width     Float     @default(200)
  height    Float     @default(120)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([processId], name: "idx_sticky_notes_process_id")
  @@map("sticky_notes")
}

enum NoteColor {
  YELLOW
  BLUE
  GREEN
  PINK
  ORANGE
  PURPLE
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("api_keys")
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenants")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CLIENT
}
